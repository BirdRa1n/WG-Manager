# Interface/porta do painel. Prefira o IP do Tailscale/LAN em vez de 0.0.0.0.
PANEL_HOST=0.0.0.0
PANEL_PORT=8765
# Gerada pelo install.sh. Se ficar vazia, o painel cria uma em DATA_DIR/.secret_key.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# API do Proxmox usada só para validar o login
PROXMOX_HOST=localhost
PROXMOX_VERIFY_SSL=false
# Privilégio exigido no Proxmox (em "/") para entrar no painel
REQUIRED_PRIVILEGE=Sys.Modify
# true quando o painel estiver atrás de HTTPS
COOKIE_SECURE=false
DATA_DIR=/opt/wg-proxy-manager
SSH_KEYS_DIR=/opt/wg-proxy-manager/keys
DB_PATH=/opt/wg-proxy-manager/data.db
